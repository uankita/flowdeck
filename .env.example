# Flowdeck — environment template
#
#   cp .env.example .env
#
# `.env` is git-ignored. Every value below is a LOCAL DEVELOPMENT default and
# must be replaced before any deployment. Compose reads this file for both
# container configuration and ${...} interpolation inside docker-compose.yml,
# so keep it at the repo root and invoke compose via `make up` (or pass
# `--env-file .env` explicitly).

# ── Postgres ──────────────────────────────────────────────────────────────
POSTGRES_DB=flowdeck
POSTGRES_USER=flowdeck
POSTGRES_PASSWORD=flowdeck_dev_only
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_PASSWORD=flowdeck_dev_only

# ── Backend (Spring Boot) ─────────────────────────────────────────────────
# `local` reads the defaults baked into application.yml; `prod` requires every
# DB_*/REDIS_* value below to be set explicitly and fails fast if any is missing.
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_NAME=flowdeck
DB_USER=flowdeck
DB_PASSWORD=flowdeck_dev_only

REDIS_HOST=localhost
# REDIS_PASSWORD is shared with the Redis service above.

# Connection pool (HikariCP) — tuned upward in prod.
DB_POOL_MAX=10

# ── Auth ──────────────────────────────────────────────────────────────────
# Dev-only placeholder. Generate a real one per environment:
#   openssl rand -base64 48
JWT_SECRET=ZGV2LW9ubHktaW5zZWN1cmUtc2VjcmV0LXJlcGxhY2UtbWUtYmVmb3JlLXByb2Q=
ACCESS_TOKEN_EXPIRY_MINUTES=15
REFRESH_TOKEN_EXPIRY_DAYS=30

# ── Frontend (Vite) ───────────────────────────────────────────────────────
# Only VITE_-prefixed vars reach browser code — never put a secret here.
#
# Leave both EMPTY for local dev: the Vite dev server proxies /api and /ws to
# the backend, so the browser stays on a single origin. Set them only when the
# built frontend is served from a different origin than the API, e.g.
#   VITE_API_BASE_URL=https://api.flowdeck.example
#   VITE_WS_URL=wss://api.flowdeck.example/ws
VITE_API_BASE_URL=
VITE_WS_URL=
